# Chave da API do MapTiler — obtenha em https://cloud.maptiler.com/account/keys/
# Sem ela a aplicação exibe um estado de fallback explícito no lugar do mapa.
NEXT_PUBLIC_MAPTILER_KEY=

# Projeto Supabase — Project Settings → API no painel.
# Só a chave `anon public` é usada. A `service_role` não é necessária em nenhum
# ponto desta aplicação e não deve entrar no repositório: a proteção do dado é a
# RLS, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Entrada por senha para desenvolvimento — opcional, e SÓ para inspecionar a
# interface logada com ferramenta automatizada. O Google recusa completar OAuth
# dentro de um navegador controlado por script, e sem entrar não há como medir
# nem capturar a tela.
#
# Não é um desvio: a credencial é verificada pelo Supabase normalmente. A rota
# `/entrar-dev` devolve 404 quando `NODE_ENV` é `production` ou quando estas
# duas variáveis não existem — e elas vivem só aqui, num arquivo ignorado pelo
# git.
#
# Para usar: crie o usuário em Authentication → Users no painel do Supabase,
# com "Auto Confirm User" marcado, e habilite o provedor Email.
RASTRO_DEV_LOGIN_EMAIL=
RASTRO_DEV_LOGIN_PASSWORD=

# Traçado real da estrada nos roteiros — opcional. Chave gratuita em
# https://openrouteservice.org/dev/#/signup
#
# Sem ela o Rastro usa a estimativa de sinuosidade e diz na tela que a distância
# é estimada, não medida. Ver ADR 0013.
#
# SEM prefixo NEXT_PUBLIC_, de propósito: a chamada acontece só no servidor e a
# chave nunca chega ao navegador.
OPENROUTESERVICE_API_KEY=

# Gancho do teste de fumaça — só desenvolvimento, opcional.
#
# Com `=1`, o `MapCanvas` expõe a instância do MapLibre em `window.__rastroMap`.
# É o que permite a um teste perguntar coisas que não existem no DOM: se as
# camadas sobreviveram a uma troca de tema, se a câmera entrou plana. Sem isso,
# `npm run smoke` falha no primeiro caso, dizendo o que falta.
#
# Dois portões, como em `/entrar-dev`: `next build` resolve `NODE_ENV` de
# produção para falso e o empacotador remove a linha inteira, e esta variável
# vive só no `.env.local`, ignorado pelo git. Ver ADR 0022.
NEXT_PUBLIC_RASTRO_E2E=

# Postos de combustível no mapa — opcional. Chave gratuita em
# https://myprojects.geoapify.com/ (3.000 créditos por dia, sem cartão).
#
# Sem ela o botão "Postos" continua na tela e diz, ao ser apertado, que a busca
# não está configurada — em vez de girar para sempre. Ver ADR 0020.
#
# SEM prefixo NEXT_PUBLIC_, e isso é o ponto todo: a consulta à Geoapify sai de
# `/api/fuel-stations`, no servidor, e a chave nunca entra no pacote entregue ao
# navegador. Uma chave de Places exposta no cliente é cota de qualquer um.
#
# No painel da Geoapify, restrinja a chave por HTTP referrer / origem antes de
# publicar.
GEOAPIFY_API_KEY=
